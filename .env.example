# WPScan API keys (required for --source wpscan)
# Register free at: https://wpscan.com/register
# Multiple keys for rotation: comma-separated
WPSCAN_API_KEYS=key1,key2,key3

# NVD API key (optional, improves CVSS enrichment rate limit 10x)
# Register at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Google Custom Search (optional, for automated SERP judol check)
# Setup: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Claude AI (optional, for --ai analysis)
# Get key at: https://console.anthropic.com/
# Or use Claude Code OAuth: run 'python scanner.py connect'
ANTHROPIC_API_KEY=
